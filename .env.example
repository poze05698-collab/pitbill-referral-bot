# ==========================================
# TITAN AFFILIATE PLATFORM
# Environment Variables
# ==========================================

# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN

# Administrador
ADMIN_ID=123456789

# Banco de Dados
DATABASE_URL=sqlite:///database.db

# Segurança
SECRET_KEY=CHANGE_THIS_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Logs
LOG_LEVEL=INFO

# Plataforma
APP_NAME=Titan Affiliate Platform
APP_VERSION=2.0.0
ENVIRONMENT=development
